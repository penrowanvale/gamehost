# Database Configuration
DATABASE_URL=your_supabase_database_url
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Configuration
JWT_SECRET=your_jwt_secret_key

# ===========================================
# ADMIN USER CREDENTIALS (Required for admin login)
# ===========================================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PHONE=+919876543210
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password

# ===========================================
# PUBLIC CONTACT DETAILS (Optional - uses admin details as fallback)
# ===========================================

# Support email shown to users (defaults to ADMIN_EMAIL if not set)
SUPPORT_EMAIL=support@yourdomain.com

# Support WhatsApp number (defaults to ADMIN_PHONE if not set)
SUPPORT_WHATSAPP=+919876543210

# Your website/app name (defaults to PLATFORM_NAME if not set)
APP_NAME=GameBlast Mobile
PLATFORM_NAME=GameBlast Mobile

# Your website URL (used in emails and links)
APP_URL=https://yourdomain.com

# Support hours (displayed on contact page)
SUPPORT_HOURS=9 AM - 9 PM IST

# ===========================================
# EMAIL CONFIGURATION (for sending emails)
# ===========================================
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Google Drive Storage Configuration (REQUIRED FOR FILE UPLOADS)
GOOGLE_SERVICE_ACCOUNT_KEY=/path/to/your/service-account-key.json
GOOGLE_DRIVE_STORAGE_FOLDER_ID=your_google_drive_folder_id

# Optional Google Drive Settings
COMPRESSION_QUALITY=75
AUTO_CLEANUP_DAYS=2
TEMP_DIR=/tmp

# Server Configuration
PORT=3000
NODE_ENV=production